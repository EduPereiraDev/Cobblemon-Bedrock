// Frente ui-base: roteador dos forms do Cobblemon por marcador invisível no início do título (scripts/ui/screens.ts).
// `§0§1§r` = PC, `§0§2§r` = batalha, `§0§3§r` = resumo, `§0§4§r` = inicial, `§0§5§r` = Pokédex (frente telas), `§0§7§r` = diálogo (frente ui-polish). Para uma tela nova: acrescente o filho aqui, o marcador na condição do
// `long_form` em server_form.json e em ROUTED_SCREENS (scripts/ui/screens.ts).
{
  "namespace": "cobblemon_forms",
  "router": {
    "type": "panel",
    "size": ["100%", "100%"],
    "controls": [
      {
        "pc_form@pc.pc_form": {
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - '§0§1§r') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "summary_form@summary.summary_form": {
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - '§0§3§r') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "starter_form@starter.starter_form": {
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - '§0§4§r') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "pokedex_form@pokedex.pokedex_form": {
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - '§0§5§r') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "dialogue_form@dialogue.dialogue_form": {
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - '§0§7§r') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "battle_form@battle.battle_form": {
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - '§0§2§r') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  }
}
