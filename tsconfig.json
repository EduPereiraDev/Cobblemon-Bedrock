// Só para type-check (`npm run check`); o bundle é feito pelo esbuild em tools/build.mjs.
{
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "allowUnreachableCode": true,
    "allowUnusedLabels": true,
    // Extensões privadas (fora do repositório público): a primeira opção existe só na árvore privada; sem ela, o stub.
    // O esbuild lê o mesmo `paths`; o build público força o stub (tools/cleanBuild.mjs).
    "paths": {
      "@private/mega-showdown": ["./scripts/extensions/megaShowdown/index.ts", "./scripts/extensions/privateStub.ts"],
      "@private/mega-showdown/content": ["./scripts/extensions/megaShowdown/content.ts", "./scripts/extensions/privateStub.ts"],
      "@private/extensions": ["./scripts/extensions/private/index.ts", "./scripts/extensions/privateStub.ts"]
    }
  },
  "include": ["scripts/**/*.ts", "generated/scripts/**/*.ts"]
}
